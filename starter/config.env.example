# ===== Server =====
NODE_ENV=development
PORT=8000

# Frontend URL (used for CORS, Stripe redirects, and email links)
CLIENT_URL=http://localhost:5173

# ===== Database (MongoDB Atlas) =====
# Full connection string with <PASSWORD> placeholder
DATABASE=mongodb+srv://<USERNAME>:<PASSWORD>@<cluster>.mongodb.net/natours?retryWrites=true&w=majority
DATABASE_PASSWORD=your-atlas-db-user-password

# ===== JWT =====
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=90d
# In days
JWT_COOKIE_EXPIRES_IN=90

# ===== Email (development: Mailtrap or any SMTP sandbox) =====
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=Natours <noreply@example.com>

# ===== Email (production: SendGrid) =====
SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=your-sendgrid-api-key

# ===== Stripe (test mode keys) =====
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Webhook signing secret.
# Local: the secret printed by `stripe listen`.
# Production: the signing secret of the endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx